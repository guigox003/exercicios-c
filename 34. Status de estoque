#include <stdio.h>
#include <stdlib.h>

// Leia o valor de uma compra. Compras a partir de R$ 200,00 recebem frete grátis; as demais pagam R$
///20,00 de frete. Exiba o valor da compra, o frete e o total do pedido.
//.

int main() {
	
	float compra = 0;
	float frete = 0;
	float total = 0;
	
	printf("Digite o valor da compra: ");
	scanf("%f", &compra);
	
	if (compra >= 200) {
		frete = 0;
	} else {
		frete = 20;
	}
	
	total = compra + frete; 
	
	printf("Valor da compra: %.2f\n", compra);
	printf("Valor da frete: %.2f\n", frete);
	printf("Valor da pedido: %.2f\n", total);
	
	return 0;
}
