#include <stdio.h>
#include <stdlib.h>

// Leia a quantidade disponível de um produto. Exiba “Disponível” quando houver unidades em estoque e
// “Esgotado” quando a quantidade for zero. Faça uma versão com if/else e outra utilizando operador
// ternário

int main () {
 int quantidade = 0;
     printf("Digite a quantidade em estoque: ");
     scanf("%d", &quantidade);
 
 if (quantidade > 0) {
     printf("Disponivel\n");
 } else {
      printf("Esgotado\n");
 }
 
 printf("Ternario: %s\\n", quantidade > 0 ? "Disponivel" : "Esgotado");
 
 return 0;
}
