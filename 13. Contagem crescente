
#include <stdio.h>
#include <stdlib.h>

//Leia um número inteiro positivo N e mostre todos os números de 1 até N.

int main() {
    int n, i;

    printf("Digite um numero inteiro positivo: ");
    scanf("%d", &n);

    for (i = 1; i <= n; i++)
        printf("%d ", i);

    printf("\n");

    return 0;
}

