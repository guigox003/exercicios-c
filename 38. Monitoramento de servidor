#include <stdio.h>
#include <stdlib.h>

// Leia percentuais de uso da CPU até que seja informado -1. Classifique cada leitura como NORMAL (até
// 69%), ALERTA (70% a 89%) ou CRÍTICO (90% a 100%). Ao final, informe o número de leituras e quantas
// foram críticas.

int main() {
	int uso = 0;
	int leituras = 0;
	int criticas = 0;
	
	while (uso != -1) {
		printf("Uso da CPU (-1 encerra): ");
		scanf("%d", &uso);
		
		if (uso == -1) {
			break;
		}
		
		if (uso < 0 || uso > 100) {
			printf("Valor invalido!\n"); 
		} else {
			leituras++;
			
			if (uso <= 69) {
				printf("NORMAL\n");
			} else if (uso <= 89) {
				printf("ALERTA\n");
			} else {
				printf("CRITICO\n");
				criticas++;
			}
		}
	}
	
	printf("Total de leituras: %d\n", leituras);
	printf("Leituras criticas: %d\n, criticas");
	
	return 0;
}
