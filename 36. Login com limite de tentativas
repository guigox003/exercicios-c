#include <stdio.h>
#include <stdlib.h>

//Defina uma senha numérica no programa. O usuário poderá tentar entrar no sistema no máximo três
//vezes. Se acertar, exiba “Acesso autorizado”. Caso as três tentativas sejam consumidas, exiba “Usuário
//bloqueado”.


int main() {
	int senha = 1234;
	int tentativa = 0;
	int tentativas = 0;
	
	while (tentativa != senha && tentativas < 3) {
		printf("Digite a senha: ");
		scanf("%d", &tentativa);
		
		tentativas++;
		
		if (tentativa != senha) {
			printf("Senha incorreta!\n");
		}
	}
	
	if (tentativa == senha) {
		printf("Acesso autorizado\n");
	} else {
		printf("Usuario bloqueado\n");
	}
	
	return 0;
}
