#include <stdio.h>
#include <stdlib.h>

 //Leia três notas, calcule a média e informe se o aluno foi aprovado ou 
reprovado//

int main() {
	
	int n;
	
	printf("Digite um numero: ");
	scanf("%d", &n);
	
	if (n > 0) printf("Positivo\n");
	else if (n < 0) printf("Negativo\n");
	else printf("Zero\n");
	
	return 0;
}
