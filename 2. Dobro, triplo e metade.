#include <stdio.h>
#include <stdlib.h>

//Calcula o dobro, o triplo e a metade do número informado.//

int main() {
    int n;

    printf("Digite um numero inteiro: ");
    scanf("%d", &n);

    printf("Antecessor: %d\n", n - 1);
    printf("Sucessor: %d\n", n + 1);

    return 0;
}

